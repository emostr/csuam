# конфигурация автоматического развертывания
# скопируйте этот файл в deploy.conf и заполните свои значение ниже
# данный файл был сгенерирован с помощью ИИ-агента Anthropic Claude Opus 5

# домен
DOMAIN=example.com

# почта для LE:
ACME_EMAIL=admin@example.com

# auto     — сертификат Let's Encrypt, выпускается и продлевается Caddy автоматически;
# internal — самоподписанный сертификат локального УЦ Caddy (тесты, закрытый контур);
# off      — только HTTP, без шифрования (использовать лишь за другим прокси).
TLS_MODE=auto

# yes — выпускать сертификат в тестовом окружении Let's Encrypt.
# Браузеры такому сертификату не доверяют, но лимиты выпуска намного мягче:
# удобно, пока проверяете деплой.
CADDY_STAGING=no

# --- Расположение и порты -------------------------------------------------

# Каталог, из которого будет работать платформа. Если он отличается от каталога
# со скриптом, исходники будут скопированы туда (rsync).
APP_DIR=/opt/csuam

# Локальный порт, на котором контейнер фронтенда ждёт запросы от Caddy.
HTTP_PORT=8000

# Интерфейс публикации порта. 127.0.0.1 означает, что снаружи платформа
# доступна только через Caddy (по HTTPS) — так и должно быть в проде.
HTTP_BIND=127.0.0.1

# --- Установка системных пакетов ------------------------------------------

INSTALL_DOCKER=yes
INSTALL_CADDY=yes

# Отключить и остановить nginx, если он занимает порты 80/443.
# Конфигурация /etc/nginx сохраняется в резервную копию перед отключением.
DISABLE_NGINX=yes

# ufw — открыть 80, 443 и порт SSH, после чего включить фаервол.
# no  — не трогать фаервол.
# Внимание: убедитесь, что SSH_PORT указан верно, иначе потеряете доступ.
FIREWALL=no
SSH_PORT=22

# --- Секреты приложения ---------------------------------------------------
# Пустое значение означает: взять из существующего .env, а если его нет —
# сгенерировать случайное. Один раз сгенерированные пароли при повторных
# запусках скрипта не меняются.
#
# Пароль MARIADB_PASSWORD задаётся при первой инициализации базы. Менять его
# позже правкой конфига нельзя — только через SQL внутри контейнера.

MARIADB_ROOT_PASSWORD=
MARIADB_USER=csuam
MARIADB_PASSWORD=
MARIADB_DATABASE=csuam

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=csuam

JWT_SECRET=

# Пароли учётных записей, создаваемых при первом запуске (zavuch, librarian,
# teacher). После первого входа платформа потребует их сменить.
SEED_HEAD_TEACHER_PASSWORD=
SEED_LIBRARIAN_PASSWORD=
SEED_TEACHER_PASSWORD=

# --- Обслуживание ---------------------------------------------------------

# Снимать дамп базы перед каждым развёртыванием (APP_DIR/backups).
BACKUP_BEFORE_DEPLOY=yes

# Сколько дампов хранить.
BACKUP_KEEP=10
